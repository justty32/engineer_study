  {
   "id": "08",
   "file": "08-small-signal.html",
   "title": "1 mA 工作點旁的 5 mV，真的只增加 0.193 mA？",
   "params": [
    {
     "key": "a",
     "id": "c08-a",
     "type": "number",
     "label": "ICQ（mA）",
     "min": 0.1,
     "max": 3,
     "step": 0.1,
     "default": 1,
     "options": []
    },
    {
     "key": "b",
     "id": "c08-b",
     "type": "number",
     "label": "vbe 增量（mV）",
     "min": -10,
     "max": 10,
     "step": 1,
     "default": 5,
     "options": []
    }
