  {
   "id": "05",
   "file": "05-bjt-bias.html",
   "title": "基極分壓 2.16 V，集極真的有 1.46 mA 嗎？",
   "params": [
    {
     "key": "a",
     "id": "c05-a",
     "type": "number",
     "label": "電流增益 β",
     "min": 50,
