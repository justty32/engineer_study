  {
   "id": "01",
   "file": "01-semiconductor.html",
   "title": "摻入更多施體，少數電洞會剩多少？",
   "params": [
    {
     "key": "a",
     "id": "c01-a",
     "type": "number",
     "label": "施體濃度 ND 的10次方指數（cm⁻³）",
     "min": 14,
     "max": 18,
     "step": 1,
     "default": 16,
     "options": []
    },
    {
     "key": "b",
     "id": "c01-b",
     "type": "number",
     "label": "電場 E（V/cm）",
     "min": 0,
     "max": 100,
     "step": 10,
     "default": 10,
